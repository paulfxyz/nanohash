{
  "name": "@paulfxyz/nanohash",
  "version": "0.2.0",
  "description": "Compact, URL-safe random IDs for JavaScript. Secure 4–15 character generation, collision sizing, atomic allocation, ESM/CJS, TypeScript, and CLI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./lite": {
      "import": { "types": "./dist/lite.d.ts", "default": "./dist/lite.js" },
      "require": { "types": "./dist/lite.d.cts", "default": "./dist/lite.cjs" }
    },
    "./analysis": {
      "import": { "types": "./dist/analysis.d.ts", "default": "./dist/analysis.js" },
      "require": { "types": "./dist/analysis.d.cts", "default": "./dist/analysis.cjs" }
    },
    "./allocation": {
      "import": { "types": "./dist/allocation.d.ts", "default": "./dist/allocation.js" },
      "require": { "types": "./dist/allocation.d.cts", "default": "./dist/allocation.cjs" }
    },
    "./package.json": "./package.json"
  },
  "bin": { "nanohash": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "docs"],
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "license": "MIT",
  "author": "Paul Fleury",
  "repository": { "type": "git", "url": "git+https://github.com/paulfxyz/nanohash.git" },
  "bugs": { "url": "https://github.com/paulfxyz/nanohash/issues" },
  "homepage": "https://github.com/paulfxyz/nanohash#readme",
  "keywords": ["nanohash", "nanoid", "id-generator", "random-id", "short-id", "url-safe", "short-links", "collision", "entropy", "typescript", "esm", "commonjs", "cli", "cryptographic-randomness"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:docs": "node scripts/check-docs.mjs",
    "size": "node scripts/measure-size.mjs",
    "size:check": "node scripts/measure-size.mjs --check",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:types",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "assets": "node scripts/render-assets.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "nanoid": "6.0.2",
    "typescript": "7.0.2"
  }
}
